# Application
NODE_ENV=development
PORT=5000

# Ateneum database and public links
ATENEUM_DB_PATH=./data/ateneum.db
ATENEUM_PUBLIC_URL=http://localhost:5000
ATENEUM_FROM_EMAIL=Ateneum <noreply@example.com>

# Required only when seeding a missing human user. Keep real values in the
# production environment file, never in source control.
ATENEUM_PARTNER_A_USERNAME=
ATENEUM_PARTNER_A_DISPLAY_NAME=
ATENEUM_PARTNER_A_EMAIL=
ATENEUM_PARTNER_A_PASSWORD=
ATENEUM_PARTNER_B_USERNAME=
ATENEUM_PARTNER_B_DISPLAY_NAME=
ATENEUM_PARTNER_B_EMAIL=
ATENEUM_PARTNER_B_PASSWORD=

# Optional system-user identity. If the password is omitted when the bot user
# is first created, Ateneum generates a non-recoverable random password.
ATENEUM_BOT_EMAIL=noreply@example.invalid
ATENEUM_BOT_PASSWORD=

# Optional SES email delivery. Without credentials, notifications are skipped.
AWS_REGION=eu-north-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Google Calendar write (P0: server-side OAuth, one shared calendar)
# Desktop OAuth client from GCP project jaakkolaxyz. Refresh token must include
# https://www.googleapis.com/auth/calendar
# Values: copy from local .env.google (gitignored) or derive from Hermes
# ~/.hermes/google_token.json — never commit real secrets.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
ATENEUM_GOOGLE_CALENDAR_ID=
# Optional: memory|google|off — default google when credentials set, else off
# ATENEUM_CALENDAR_BACKEND=
# ATENEUM_CALENDAR_TIME_ZONE=Europe/Helsinki

# Cron secret for POST /api/ateneum/body-practice/weekly-run (header X-Ateneum-Cron-Secret)
ATENEUM_CRON_SECRET=
