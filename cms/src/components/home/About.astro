---
import type { HomeContent } from "../../i18n/home";

interface Props {
	content: HomeContent;
}

const { content } = Astro.props;
const { title, text, signature } = content.about;
---

<section aria-label={title} class="bg-secondary/20 py-24">
	<div class="container mx-auto max-w-4xl px-4 text-center md:px-6">
		<div class="reveal reveal-scale space-y-8">
			<svg class="mx-auto h-12 w-12 rotate-180 text-primary/20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 21c3 0 7-1 7-8V5c0-1.25-.756-2.017-2-2H4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2 1 0 1 0 1 1v1c0 1-1 2-2 2s-1 .008-1 1.031V20c0 1 0 1 1 1z"></path><path d="M15 21c3 0 7-1 7-8V5c0-1.25-.757-2.017-2-2h-4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2h.75c0 2.25.25 4-2.75 4v3c0 1 0 1 1 1z"></path></svg>

			<h2 class="font-serif text-2xl leading-relaxed italic md:text-4xl md:leading-relaxed">"{text}"</h2>

			<div class="pt-4">
				<span class="inline-block border-t border-primary/20 px-8 pt-4 font-mono text-lg font-medium tracking-widest uppercase">
					{signature}
				</span>
			</div>
		</div>
	</div>
</section>
