---
import { LeadCapture } from "../LeadCapture";
import type { HomeContent } from "../../i18n/home";
import { getLang } from "../../i18n/ui";

interface Props {
	content: HomeContent;
}

const { content } = Astro.props;
const lang = getLang(Astro);
---

<!-- Contact section. The island renders its own heading and intro in the left column, as the old component did. -->
<section id="lead-capture" class="scroll-mt-24 border-t border-border/40 bg-background py-24">
	<div class="container mx-auto max-w-5xl px-4 md:px-6">
		<LeadCapture client:visible lang={lang} content={content.leadCapture} />
	</div>
</section>
