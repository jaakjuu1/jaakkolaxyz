---
/**
 * Blog index for one locale: /blog (fi) and /en/blog (en).
 * Published posts of the locale, newest first.
 */
import Base from "../layouts/Base.astro";
import BlogCard from "./BlogCard.astro";
import { localizePath, otherLang, t, type Lang } from "../i18n/ui";
import { listPublishedPosts } from "../utils/blog";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const { posts, cacheHint } = await listPublishedPosts(lang);
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const title = t(lang, "blog.title");
const intro = t(lang, "blog.intro");
---

<Base
	title={title}
	description={intro}
	lang={lang}
	translationPath={localizePath("/blog", otherLang(lang))}
>
	<section class="container mx-auto max-w-4xl px-4 py-16 md:px-6">
		<header class="mb-16">
			<h1 class="mb-4 font-serif text-4xl tracking-tight md:text-5xl">{title}</h1>
			<p class="text-lg text-muted-foreground">{intro}</p>
			<div class="mt-6 h-1 w-20 rounded-full bg-primary/10"></div>
		</header>

		{
			posts.length === 0 ? (
				<p class="py-16 text-center text-muted-foreground">{t(lang, "blog.empty")}</p>
			) : (
				<div class="grid grid-cols-1 gap-6">
					{posts.map(({ entry, tags }) => (
						<BlogCard lang={lang} entry={entry} tags={tags} />
					))}
				</div>
			)
		}
	</section>
</Base>
