---
import BlogPostPage from "../../../components/BlogPostPage.astro";
import NotFound from "../../../components/NotFound.astro";
import { isPostPath, loadPublishedPost, postSlug } from "../../../utils/blog";

// Only the post's own URL serves it: /en/blog/<slug>.html and other variants are 404s.
const found = await loadPublishedPost("en", Astro.params.slug);
const post = found && isPostPath(Astro.url, "en", postSlug(found.entry)) ? found : null;
if (Astro.cache?.enabled && post) Astro.cache.set(post.cacheHint);
if (!post) Astro.response.status = 404;
---

{post ? <BlogPostPage lang="en" post={post} /> : <NotFound lang="en" />}
