---
import ContentPage from "../../components/ContentPage.astro";
import NotFound from "../../components/NotFound.astro";
import { isPagePath, loadPublishedPage, pageSlug } from "../../utils/pages";

// English pages under /en/, e.g. /en/privacy. Only the page's own URL serves it.
const found = await loadPublishedPage("en", Astro.params.slug);
const page = found && isPagePath(Astro.url, "en", pageSlug(found.entry)) ? found : null;
if (Astro.cache?.enabled && page) Astro.cache.set(page.cacheHint);
if (!page) Astro.response.status = 404;
---

{page ? <ContentPage lang="en" page={page} /> : <NotFound lang="en" />}
