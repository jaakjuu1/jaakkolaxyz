---
import BlogPostPage from "../../components/BlogPostPage.astro";
import NotFound from "../../components/NotFound.astro";
import { isPostPath, legacyBlogRedirect, loadPublishedPost, postSlug } from "../../utils/blog";
import { requestPath } from "../../utils/request-path";

// Finnish post URLs. An old URL whose post exists only in English moves to
// /en/blog/<slug>; placeholder posts move to /blog; anything else is a 404.
// Only the post's own URL serves it: /blog/<slug>.html and other variants are 404s.
const found = await loadPublishedPost("fi", Astro.params.slug);
const post = found && isPostPath(Astro.url, "fi", postSlug(found.entry)) ? found : null;
if (Astro.cache?.enabled && post) Astro.cache.set(post.cacheHint);

if (!post) {
	// Redirect only the exact old path: /blog/<slug>.html is a 404, not a redirect.
	const exactPath = requestPath(Astro.url) === `/blog/${Astro.params.slug}`;
	const target = found || !exactPath ? null : await legacyBlogRedirect(Astro.params.slug);
	if (target) return Astro.redirect(target, 301);
	Astro.response.status = 404;
}
---

{post ? <BlogPostPage lang="fi" post={post} /> : <NotFound lang="fi" />}
